# Copy this file to .env and fill in real values. Never commit .env.
PORT=4478
DB_PATH=./data/prm.db

# BotFather token for PRM's own dedicated bot (not shared with Kage).
TELEGRAM_BOT_TOKEN=
# Chat for the original user (LEGACY_OWNER_USERNAME). Every other account gets
# its alerts in the chat set for it in the accounts service.
TELEGRAM_CHAT_ID=

# How often the scheduler checks for due alerts and runs settleAutoCharges, in seconds.
SCHEDULER_INTERVAL_SECONDS=60

# Shared accounts service (see the accounts project). Same token as its SERVICE_TOKEN.
ACCOUNTS_URL=http://accounts:4600
ACCOUNTS_SERVICE_TOKEN=
# The admin account that owns records saved before accounts existed, and the
# one whose alerts go to TELEGRAM_CHAT_ID when it has no chat of its own.
LEGACY_OWNER_USERNAME=
# Set to false only for local development over plain http.
COOKIE_SECURE=true
