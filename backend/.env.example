# Copy this file to .env and fill in real values. Never commit .env.
PORT=4478
DB_PATH=./data/prm.db

# BotFather token for PRM's own dedicated bot (not shared with Kage).
TELEGRAM_BOT_TOKEN=
# Moe's personal chat id (the bot sends reminders only here).
TELEGRAM_CHAT_ID=

# How often the scheduler checks for due alerts and runs settleAutoCharges, in seconds.
SCHEDULER_INTERVAL_SECONDS=60
